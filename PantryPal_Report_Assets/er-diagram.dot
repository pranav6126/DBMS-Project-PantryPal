relationship8 [shape=diamond label="contains" style=filled fillcolor="#f7f5e8" color="#9c946f"];
meal_plan -- relationship8 [headlabel="1" labeldistance=1.7]; relationship8 -- meal_plan_item [taillabel="0..N" labeldistance=1.7];
relationship9 [shape=diamond label="scheduled in" style=filled fillcolor="#f7f5e8" color="#9c946f"];
