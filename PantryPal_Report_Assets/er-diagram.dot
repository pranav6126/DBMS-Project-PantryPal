graph ER { rankdir=LR; graph [fontname="Helvetica", bgcolor="white", pad="0.45", nodesep="0.45", ranksep="1.1", splines=polyline]; node [fontname="Helvetica", fontsize=12]; edge [fontname="Helvetica", fontsize=10, color="#52665b", fontcolor="#263b2d"];
