recipe_diet_type [shape=ellipse label=<diet_type> color="#98aa9d"]; recipe -- recipe_diet_type [color="#9fac9f"];
recipe_times_cooked [shape=ellipse label=<times_cooked> color="#98aa9d"]; recipe -- recipe_times_cooked [color="#9fac9f"];
