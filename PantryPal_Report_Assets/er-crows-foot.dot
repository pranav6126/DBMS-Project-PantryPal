digraph ER { rankdir=LR; graph [fontname="Helvetica", bgcolor="white", pad="0.45", nodesep="0.45", ranksep="1.1", splines=polyline]; node [fontname="Helvetica", fontsize=12]; edge [fontname="Helvetica", fontsize=10, color="#52665b", fontcolor="#263b2d"];
app_user [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">diet_pref</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
ingredient [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>ingredient</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>ingredient_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">shelf_life_days</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
recipe [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>recipe</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>recipe_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cuisine</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">diet_type</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">prep_minutes</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">calories</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">times_cooked</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">INT nullable</TD></TR></TABLE>>];
pantry_item [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>pantry_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>pantry_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ingredient_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">purchased_on</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR></TABLE>>];
recipe_ingredient [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>recipe_ingredient</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><U>recipe_id</U></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT"><U>ingredient_id</U></TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_optional</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
rating [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>rating</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>rating_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">recipe_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rated_on</TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
meal_plan [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>meal_plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>plan_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">plan_name</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">week_start</TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
meal_plan_item [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>meal_plan_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>item_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">plan_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">recipe_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">planned_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">meal_slot</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR></TABLE>>];
app_session [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8a9a8e"><TR><TD COLSPAN="3" BGCOLOR="#133f2b"><FONT COLOR="white"><B>app_session</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><U>session_id</U></TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">CHAR(64)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR></TABLE>>];
app_user -> pantry_item [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="user_id"];
ingredient -> pantry_item [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="ingredient_id"];
app_user -> recipe [dir=both arrowtail="teeodot" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="created_by"];
recipe -> recipe_ingredient [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="solid" label="recipe_id"];
ingredient -> recipe_ingredient [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="solid" label="ingredient_id"];
app_user -> rating [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="user_id"];
recipe -> rating [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="recipe_id"];
app_user -> meal_plan [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="user_id"];
meal_plan -> meal_plan_item [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="plan_id"];
recipe -> meal_plan_item [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="recipe_id"];
app_user -> app_session [dir=both arrowtail="teetee" arrowhead="crowodot" arrowsize=0.9 style="dashed" label="user_id"];
label="PantryPal logical ER diagram — Crow’s Foot notation
PK: primary key   FK: foreign key   UK: unique key
Circle: zero   Bar: one   Crow’s foot: many
Children are optional collections; recipe.created_by is nullable.
Solid: identifying relationship   Dashed: non-identifying relationship"; labelloc=b; fontsize=14; }